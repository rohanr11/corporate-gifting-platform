// Prisma schema — defines our SQLite tables.
// Because Prisma abstracts the SQL dialect, switching "provider" to
// "postgresql" later (plus updating DATABASE_URL) is enough to move
// to Postgres in production — no frontend or route code changes needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String
  imageUrl    String
  products    Product[]
}

model Product {
  id               Int            @id @default(autoincrement())
  name             String
  slug             String         @unique
  description      String
  shortDescription String
  price            Int
  imageUrl         String
  categoryId       Int
  category         Category       @relation(fields: [categoryId], references: [id])
  tags             String // comma-separated
  minOrderQty      Int            @default(1)
  inStock          Boolean        @default(true)
  rating           Float          @default(4.5)
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
}

// No real auth — a random "sessionId" is generated client-side and stored
// in localStorage, then sent with every cart/wishlist request. This lets
// each visitor have a persistent cart without building a login system,
// matching the brief's "mock authentication only if needed".
model CartItem {
  id        Int     @id @default(autoincrement())
  sessionId String
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)

  @@unique([sessionId, productId])
}

model WishlistItem {
  id        Int     @id @default(autoincrement())
  sessionId String
  productId Int
  product   Product @relation(fields: [productId], references: [id])

  @@unique([sessionId, productId])
}
